{
  "info": {
    "name": "Inventory Management API - Categories",
    "description": "Skenario pengujian modul Categories (CRUD, validasi 400, tidak ditemukan 404, duplikat 409). Jalankan folder secara berurutan dengan Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Categories",
      "item": [
        {
          "name": "Create category (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"categoryId\", body.data.id);",
                  "pm.test(\"Data tersimpan\", function () { pm.expect(body.data.name).to.eql(\"Elektronik\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Elektronik\",\n  \"description\": \"Perangkat elektronik\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {

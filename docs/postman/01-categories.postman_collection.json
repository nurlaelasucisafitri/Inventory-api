                  "pm.test(\"Pesan error memuat: sudah ada\", function () { const m = [].concat(body.message).join(' | '); pm.expect(m).to.include(\"sudah ada\"); });",
                  "pm.test(\"success = false\", function () { pm.expect(body.success).to.eql(false); });"
                ]
              }
            }
          ],
